{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:dev": "pnpm electron:compile && concurrently -k \"pnpm dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "pnpm build && pnpm electron:compile && electron-builder",
    "desktop:win": "pnpm build && pnpm electron:compile && electron-builder --win nsis",
    "desktop:mac": "pnpm build && pnpm electron:compile && electron-builder --mac dmg",
    "electron:compile": "tsc -p electron/tsconfig.json"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.humankit.app",
    "productName": "HumanKit",
    "files": [
      "out/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.healthcare-fitness"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@smartspectra/node-sdk": "^3.4.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "5.7.3",
    "wait-on": "^8.0.3"
  }
}
